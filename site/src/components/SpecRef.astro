---
/**
 * Cross-reference link to a spec page.
 * Usage in Markdoc: {% spec-ref page="variables" /%}
 */
interface Props {
	page: string;
}

const { page } = Astro.props;

const pageMap: Record<string, { title: string; slug: string }> = {
	'basics': { title: 'File Basics', slug: '/spec/basics/' },
	'requests': { title: 'Requests', slug: '/spec/requests/' },
	'separators': { title: 'Separators & Comments', slug: '/spec/separators/' },
	'variables': { title: 'Variables', slug: '/spec/variables/' },
	'environments': { title: 'Environments', slug: '/spec/environments/' },
	'dynamic-variables': { title: 'Dynamic Variables', slug: '/spec/dynamic-variables/' },
	'metadata': { title: 'Metadata & Annotations', slug: '/spec/metadata/' },
	'auth': { title: 'Authentication', slug: '/spec/auth/' },
	'file-operations': { title: 'File Operations', slug: '/spec/file-operations/' },
	'graphql': { title: 'GraphQL', slug: '/spec/graphql/' },
	'response-handlers': { title: 'Response Handlers', slug: '/spec/response-handlers/' },
	'pre-request-scripts': { title: 'Pre-Request Scripts', slug: '/spec/pre-request-scripts/' },
	'cookies': { title: 'Cookies', slug: '/spec/cookies/' },
	'ssl': { title: 'SSL & Certificates', slug: '/spec/ssl/' },
	'proxy': { title: 'Proxy', slug: '/spec/proxy/' },
	'protocols': { title: 'Protocols', slug: '/spec/protocols/' },
	'curl': { title: 'cURL Integration', slug: '/spec/curl/' },
};

const ref = pageMap[page];
if (!ref) throw new Error(`Unknown spec page: ${page}`);
---

<a href={ref.slug} class="spec-ref">{ref.title}</a>

<style>
	.spec-ref {
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--sl-color-accent-high);
	}

	.spec-ref:hover {
		text-decoration: underline;
	}
</style>
